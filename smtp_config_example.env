# Configuración SMTP para emails reales
# Reemplaza estos valores en tu archivo .env

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password-de-gmail
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=tu-email@gmail.com
MAIL_FROM_NAME="Portal Condominio"

# NOTA: Para Gmail necesitas generar una "Contraseña de aplicación"
# Ve a: Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones